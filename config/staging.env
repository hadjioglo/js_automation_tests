# Staging Environment Configuration
# Factory Direct Website Testing Framework

# Application Settings
BASE_URL=https://staging.factory-direct.tilda.ws/
ENV=staging
API_BASE_URL=https://api-staging.factory-direct.com/v1
TIMEOUT=45000
HEADLESS=true
SLOW_MO=50

# Browser Configuration
BROWSER=chromium
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Test Configuration
PARALLEL_WORKERS=3
RETRIES=2
SCREENSHOT_MODE=only-on-failure
VIDEO_MODE=retain-on-failure
TRACE_MODE=retain-on-failure

# Reporting
REPORT_FORMAT=html,allure
ALLURE_RESULTS_DIR=reports/allure-results
HTML_REPORT_DIR=reports/html

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE=logs/test-staging.log

# Test Data
TEST_DATA_FILE=data/testData.json
USERS_DATA_FILE=data/users.json

# Authentication
DEFAULT_USER_EMAIL=staging-test@factory-direct.com
DEFAULT_USER_PASSWORD=StagingPassword123!
ADMIN_USER_EMAIL=staging-admin@factory-direct.com
ADMIN_USER_PASSWORD=StagingAdminPassword123!

# Feature Flags
ENABLE_API_TESTS=true
ENABLE_VISUAL_TESTS=true
ENABLE_PERFORMANCE_TESTS=true
ENABLE_ACCESSIBILITY_TESTS=true

# Third-party Integrations
ENABLE_SLACK_NOTIFICATIONS=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/STAGING/WEBHOOK
ENABLE_EMAIL_REPORTS=true
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Database
DB_HOST=staging-db.factory-direct.com
DB_PORT=5432
DB_NAME=factory_direct_staging
DB_USER=staging_user
DB_PASSWORD=staging_password

# Mobile Testing
MOBILE_DEVICE=iPhone 13
TABLET_DEVICE=iPad Pro