# Development Environment Configuration
# Factory Direct Website Testing Framework

# Application Settings
BASE_URL=https://factory-direct.tilda.ws/
ENV=development
API_BASE_URL=https://api.factory-direct.com/v1
TIMEOUT=30000
HEADLESS=true
SLOW_MO=100

# Browser Configuration
BROWSER=chromium
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Test Configuration
PARALLEL_WORKERS=2
RETRIES=1
SCREENSHOT_MODE=only-on-failure
VIDEO_MODE=retain-on-failure
TRACE_MODE=retain-on-failure

# Reporting
REPORT_FORMAT=html
ALLURE_RESULTS_DIR=reports/allure-results
HTML_REPORT_DIR=reports/html

# Logging
LOG_LEVEL=debug
LOG_TO_FILE=true
LOG_FILE=logs/test-dev.log

# Test Data
TEST_DATA_FILE=data/testData.json
USERS_DATA_FILE=data/users.json

# Authentication
DEFAULT_USER_EMAIL=test@factory-direct.com
DEFAULT_USER_PASSWORD=TestPassword123!
ADMIN_USER_EMAIL=admin@factory-direct.com
ADMIN_USER_PASSWORD=AdminPassword123!

# Feature Flags
ENABLE_API_TESTS=true
ENABLE_VISUAL_TESTS=true
ENABLE_PERFORMANCE_TESTS=false
ENABLE_ACCESSIBILITY_TESTS=true

# Third-party Integrations
ENABLE_SLACK_NOTIFICATIONS=false
SLACK_WEBHOOK_URL=
ENABLE_EMAIL_REPORTS=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587

# Database (if applicable)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=factory_direct_test
DB_USER=test_user
DB_PASSWORD=test_password

# Mobile Testing
MOBILE_DEVICE=iPhone 13
TABLET_DEVICE=iPad Pro