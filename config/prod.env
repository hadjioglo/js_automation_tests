# Production Environment Configuration
# Factory Direct Website Testing Framework

# Application Settings
BASE_URL=https://factory-direct.tilda.ws/
ENV=production
API_BASE_URL=https://api.factory-direct.com/v1
TIMEOUT=60000
HEADLESS=true
SLOW_MO=0

# Browser Configuration
BROWSER=chromium
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Test Configuration
PARALLEL_WORKERS=4
RETRIES=3
SCREENSHOT_MODE=only-on-failure
VIDEO_MODE=off
TRACE_MODE=off

# Reporting
REPORT_FORMAT=html,allure,json
ALLURE_RESULTS_DIR=reports/allure-results
HTML_REPORT_DIR=reports/html

# Logging
LOG_LEVEL=warn
LOG_TO_FILE=true
LOG_FILE=logs/test-production.log

# Test Data
TEST_DATA_FILE=data/testData.json
USERS_DATA_FILE=data/users.json

# Authentication
DEFAULT_USER_EMAIL=prod-test@factory-direct.com
DEFAULT_USER_PASSWORD=ProductionPassword123!
ADMIN_USER_EMAIL=prod-admin@factory-direct.com
ADMIN_USER_PASSWORD=ProductionAdminPassword123!

# Feature Flags
ENABLE_API_TESTS=true
ENABLE_VISUAL_TESTS=false
ENABLE_PERFORMANCE_TESTS=true
ENABLE_ACCESSIBILITY_TESTS=false

# Third-party Integrations
ENABLE_SLACK_NOTIFICATIONS=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/PRODUCTION/WEBHOOK
ENABLE_EMAIL_REPORTS=true
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Database
DB_HOST=prod-db.factory-direct.com
DB_PORT=5432
DB_NAME=factory_direct_production
DB_USER=prod_user
DB_PASSWORD=prod_password

# Mobile Testing
MOBILE_DEVICE=iPhone 13
TABLET_DEVICE=iPad Pro

# Security
ENABLE_SSL_VERIFICATION=true
API_KEY_HEADER=X-API-Key
RATE_LIMIT_ENABLED=true