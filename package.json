{
  "name": "factory-direct-playwright-framework",
  "version": "2.0.0",
  "description": "Production-ready Playwright TypeScript framework for Factory Direct website testing",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:bdd",
    "test:bdd": "npx cucumber-js",
    "test:bdd:smoke": "npx cucumber-js --tags @smoke",
    "test:bdd:regression": "npx cucumber-js --tags @regression",
    "test:bdd:report": "node features/support/report-generator.js",
    "test:e2e": "npx playwright test",
    "test:e2e:technical": "npx playwright test --grep @technical",
    "test:e2e:compatibility": "npx playwright test --grep @compatibility",
    "test:e2e:debug": "npx playwright test --grep @debug",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:ui": "npx playwright test --ui",
    "test:performance": "npx playwright test --grep @technical",
    "test:all": "npm run test:bdd && npm run test:e2e",
    "test:quick": "npm run test:bdd:smoke",
    "test:cross-browser": "npx playwright test --grep @compatibility",
    "test:parallel": "npx playwright test --workers=4",
    "test:serial": "npx playwright test --workers=1",
    "test:retry": "npx playwright test --retries=3",
    "test:update-snapshots": "npx playwright test --update-snapshots",
    "test:visual": "npx playwright test --project=visual-regression",
    "test:visual:update": "npx playwright test --project=visual-regression --update-snapshots",
    "test:visual:ui": "npx playwright test --project=visual-regression --ui",
    "test:accessibility": "npx playwright test --project=accessibility",
    "test:accessibility:smoke": "npx playwright test --project=accessibility-smoke",
    "test:accessibility:report": "npx playwright test --project=accessibility && echo 'Accessibility report generated in test-results/accessibility/'",
    "test:prod": "npx cross-env ENV=production npx playwright test",
    "test:api": "npx playwright test --grep @api",
    "test:api:dev": "npx cross-env TEST_ENV=development npx playwright test --grep @api",
    "test:api:staging": "npx cross-env TEST_ENV=staging npx playwright test --grep @api",
    "test:api:prod": "npx cross-env TEST_ENV=production npx playwright test --grep @api",
    "test:api:form-submission": "npx playwright test api/specs/formSubmission.spec.ts",
    "test:api:parallel": "npx playwright test --grep @api --workers=4",
    "test:api:serial": "npx playwright test --grep @api --workers=1",
    "test:api:headed": "npx playwright test --grep @api --headed",
    "test:api:debug": "npx playwright test --grep @api --debug",
    "cucumber": "npx cucumber-js --format progress-bar --format html:reports/cucumber-report.html --format json:reports/cucumber-report.json",
    "cucumber:smoke": "npx cucumber-js --tags @smoke --format progress-bar --format html:reports/cucumber-report.html --format json:reports/cucumber-report.json",
    "cucumber:regression": "npx cucumber-js --tags @regression --format progress-bar --format html:reports/cucumber-report.html --format json:reports/cucumber-report.json",
    "cucumber:ci": "npx cross-env CI=true HEADLESS=true npx cucumber-js --format progress-bar --format html:reports/cucumber-report.html --format json:reports/cucumber-report.json",
    "cucumber:report": "node features/support/report-generator.js",
    "report:allure": "npx allure generate reports/allure-results --clean -o reports/allure-report && npx allure open reports/allure-report",
    "report:html": "npx playwright show-report",
    "report:json": "cat reports/test-results.json | jq .",
    "install:browsers": "npx playwright install",
    "install:deps": "npx playwright install-deps",
    "setup": "npm run install:browsers && npm run install:deps",
    "lint": "eslint . --ext .ts --fix",
    "lint:check": "eslint . --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "clean": "npx rimraf test-results reports/html reports/allure-results reports/allure-report node_modules/.cache",
    "pretest": "npm run typecheck",
    "posttest": "npm run report:html",
    "ci:test": "npx cross-env CI=true npx playwright test --project smoke",
    "ci:full": "npx cross-env CI=true npx playwright test",
    "dev": "echo 'No dev server configured'",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "keywords": [
    "playwright",
    "typescript",
    "testing",
    "e2e",
    "api",
    "automation",
    "factory-direct",
    "web-testing"
  ],
  "author": "QA Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@cucumber/cucumber": "^7.3.2",
    "@cucumber/playwright": "^3.1.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "cross-env": "^7.0.3",
    "cucumber-html-reporter": "^7.2.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^0.20.0",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "winston": "^3.11.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/factory-direct-tests.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/factory-direct-tests/issues"
  },
  "homepage": "https://github.com/your-org/factory-direct-tests#readme"
}
